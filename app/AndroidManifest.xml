<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.wangzhe.jiaoyanshi"
    android:versionCode="10"
    android:versionName="2.3.1">

    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="34" />

    <!-- Only used as a defensive fallback to the online copy if the bundled assets ever fail. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- BP 语音输入：系统 SpeechRecognizer 需要录音权限 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+ 包可见性：让 SpeechRecognizer 能查到系统识别服务 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density"
            android:enableOnBackInvokedCallback="false"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 分享生成的战绩图（自带极简 FileProvider，避免 AndroidX 依赖） -->
        <provider
            android:name=".ShareProvider"
            android:authorities="com.wangzhe.jiaoyanshi.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
