<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.wangzhe.jiaoyanshi"
    android:versionCode="36"
    android:versionName="2.8.2">

    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="34" />

    <!-- Only used as a defensive fallback to the online copy if the bundled assets ever fail. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- BP 璇煶杈撳叆锛氱郴缁?SpeechRecognizer 闇€瑕佸綍闊虫潈闄?-->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+ 鍖呭彲瑙佹€э細璁?SpeechRecognizer 鑳芥煡鍒扮郴缁熻瘑鍒湇鍔?-->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density"
            android:enableOnBackInvokedCallback="false"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 鍒嗕韩鐢熸垚鐨勬垬缁╁浘锛堣嚜甯︽瀬绠€ FileProvider锛岄伩鍏?AndroidX 渚濊禆锛?-->
        <provider
            android:name=".ShareProvider"
            android:authorities="com.wangzhe.jiaoyanshi.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
